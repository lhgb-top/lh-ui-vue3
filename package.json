{
  "name": "@lh-ui/vue3",
  "type": "module",
  "version": "1.0.0",
  "description": "A Vue 3 UI Component Library - Enterprise-grade open-source framework",
  "license": "Apache-2.0",
  "author": "lhgb <i@lhgb.top>",
  "homepage": "https://www.lhgb.top/lhui/plus/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lhgb-top/lh-ui-plus.git"
  },
  "bugs": {
    "url": "https://github.com/lhgb-top/lh-ui-plus/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "typescript",
    "chinese-style",
    "ink-wash",
    "lh-ui"
  ],
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/vue3.js",
  "jsdelivr": "dist/vue3.js",
  "types": "es/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.js",
    "./dist": "./dist/vue3.js",
    "./dist/*": "./dist/*",
    "./theme": {
      "types": "./es/theme/index.d.ts",
      "import": "./es/theme/index.js",
      "require": "./lib/theme/index.js"
    },
    "./style/*": "./es/*/style/index.scss",
    "./style-css/*": "./es/*/style/index.css"
  },
  "files": [
    "es",
    "lib",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c --environment BUILD:production && node scripts/build-styles.mjs && rollup -c rollup.dts.config.js && rollup -c --environment FORMAT:umd",
    "build:esm": "rollup -c --environment FORMAT:esm",
    "build:dts": "rollup -c rollup.dts.config.js",
    "build:cjs": "rollup -c --environment FORMAT:cjs",
    "build:umd": "rollup -c --environment FORMAT:umd",
    "build:styles": "node scripts/build-styles.mjs",
    "verify:dts": "node scripts/verify-dts.mjs",
    "theme:check": "node scripts/verify-theme-contrast.mjs",
    "lint": "eslint src packages tests dev scripts rollup.config.js rollup.dts.config.js vite.config.ts vitest.config.ts",
    "lint:fix": "eslint src packages tests dev scripts rollup.config.js rollup.dts.config.js vite.config.ts vitest.config.ts --fix",
    "format": "prettier --write eslint.config.mjs rollup.dts.config.js .prettierrc.json .changeset/**/*.md",
    "format:check": "prettier --check eslint.config.mjs rollup.dts.config.js .prettierrc.json .changeset/**/*.md",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs --port 5178",
    "docs:build": "node scripts/build-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "api:check": "node scripts/gen-api-tables.mjs --check",
    "api:fix": "node scripts/gen-api-tables.mjs --fix",
    "docs:check-demos": "node scripts/check-api-style-pairs.mjs --check --check-demos",
    "types:check": "node scripts/gen-type-docs.mjs --check",
    "types:fix": "node scripts/gen-type-docs.mjs --fix"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "pnpm": "^10.34.6",
    "prettier": "^3.9.9",
    "rollup": "^4.64.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-string": "^3.0.0",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@lh-ui/share": "^0.3.0"
  }
}
