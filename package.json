{
  "name": "lh-ui-plus",
  "version": "1.0.0",
  "description": "A Vue 3 UI Component Library - Enterprise-grade open-source framework",
  "main": "lib/index.js",
  "module": "es/index.mjs",
  "unpkg": "dist/lh-ui-plus.umd.js",
  "jsdelivr": "dist/lh-ui-plus.umd.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.mjs",
    "./dist": "./dist/lh-ui-plus.umd.js",
    "./style/*": "./packages/components/*/style/index.scss"
  },
  "files": [
    "es",
    "lib",
    "dist",
    "packages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c --environment BUILD:production",
    "build:esm": "rollup -c --environment FORMAT:esm",
    "build:cjs": "rollup -c --environment FORMAT:cjs",
    "build:umd": "rollup -c --environment FORMAT:umd",
    "lint": "echo \"TODO: Add ESLint configuration\"",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.21",
    "autoprefixer": "^10.4.0",
    "pnpm": "^10.17.1",
    "rollup": "^4.52.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.93.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitepress": "^1.3.0",
    "vue": "^3.5.21"
  }
}