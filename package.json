{
  "name": "lh-ui-plus",
  "version": "1.0.0",
  "description": "A Vue 3 UI Component Library - Enterprise-grade open-source framework",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/lh-ui-plus.js",
  "jsdelivr": "dist/lh-ui-plus.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.js",
    "./dist": "./dist/lh-ui-plus.js",
    "./style/*": "./packages/components/*/style/index.scss"
  },
  "files": [
    "es",
    "lib",
    "dist",
    "packages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c --environment BUILD:production && rollup -c rollup.dts.config.js",
    "build:esm": "rollup -c --environment FORMAT:esm",
    "build:dts": "rollup -c rollup.dts.config.js",
    "build:cjs": "rollup -c --environment FORMAT:cjs",
    "build:umd": "rollup -c --environment FORMAT:umd",
    "lint": "eslint src packages tests dev rollup.config.js rollup.dts.config.js vite.config.ts vitest.config.ts",
    "lint:fix": "eslint src packages tests dev rollup.config.js rollup.dts.config.js vite.config.ts vitest.config.ts --fix",
    "format": "prettier --write eslint.config.mjs rollup.dts.config.js .prettierrc.json .changeset/**/*.md",
    "format:check": "prettier --check eslint.config.mjs rollup.dts.config.js .prettierrc.json .changeset/**/*.md",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.21",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "pnpm": "^10.17.1",
    "prettier": "^3.9.6",
    "rollup": "^4.52.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-string": "^3.0.0",
    "sass": "^1.93.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitepress": "^1.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.21"
  }
}