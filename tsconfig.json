{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "moduleResolution": "bundler",
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "lh-ui": [
                "src/index.ts"
            ],
            "constants": [
                "packages/constants/index.ts"
            ],
            "~/*": [
                "packages/*"
            ],
            "packages/*": [
                "packages/*"
            ],
            "@lh-ui/core/*": [
                "packages/core/*"
            ]
        },
        "types": [
            "vite/client"
        ],
        "outDir": "dist/types",
    },
    "include": [
        "env.d.ts",
        "src/**/*",
        "packages/**/*",
        "types/**/*",
        "dev/**/*",
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}