{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "moduleResolution": "bundler",
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@lh-ui/vue3": [
                "./src/index.ts"
            ],
            "~/*": [
                "./packages/*"
            ],
            "packages/*": [
                "./packages/*"
            ],
            "lh-types/*":[
                "./types/*"
            ]
        },
        "types": [
            "vite/client"
        ],
        "outDir": "dist/types"
    },
    "include": [
        "env.d.ts",
        "src/**/*",
        "packages/**/*",
        "types/**/*",
        "dev/**/*",
        "docs/.vitepress/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "coverage/**/**"
    ]
}